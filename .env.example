# OpenRampart configuration
#
# Copy to .env and fill in the values marked REQUIRED. Every setting is read from the
# environment, so in Dokploy you can paste these into the Environment tab instead.
# The server validates everything at startup and lists every problem it finds.
# Full reference: docs/configuration.md

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# REQUIRED. The public address people (and MCP clients) use. Must be https:// in
# production, except for http://localhost. No trailing slash.
APP_URL=https://rampart.example.org

# development | production | test
NODE_ENV=production

# all = web server and background worker in one process (default).
# web / worker = split them across containers sharing the same database and storage.
OPENRAMPART_ROLE=all

HOST=0.0.0.0
PORT=3000

# How many reverse proxies sit in front of the app (Dokploy/Traefik = 1).
# Accepts a number, true/false, or an Express trust-proxy list such as "loopback, 10.0.0.0/8".
TRUST_PROXY=1

# fatal | error | warn | info | debug | trace | silent
# Logs never contain passwords, tokens, attachment contents or OCR text.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database (PostgreSQL 15 or newer; the pg_trgm and pgcrypto extensions are created by migrations)
# ---------------------------------------------------------------------------

# REQUIRED.
DATABASE_URL=postgres://openrampart:change-me@postgres:5432/openrampart
# disable | require | no-verify (use "require" for managed databases with TLS)
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

# Used by docker-compose.yml for its bundled PostgreSQL service.
POSTGRES_USER=openrampart
POSTGRES_PASSWORD=change-me
POSTGRES_DB=openrampart

# ---------------------------------------------------------------------------
# Secrets — generate each one, keep them out of version control, back them up.
# ---------------------------------------------------------------------------

# REQUIRED. At least 32 characters. Signs session and token hashes.
#   openssl rand -base64 48
SESSION_SECRET=

# REQUIRED. 32 random bytes, base64. Encrypts TOTP secrets and the OAuth signing key.
# Losing it means every person must re-enrol their authenticator app.
#   openssl rand -base64 32
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Accounts and sessions
# ---------------------------------------------------------------------------

# first-user = only the first account can register (it becomes the administrator);
#              further people join by Helper invitation or are enabled by the administrator.
# open       = anyone who can reach the site can create their own record.
# closed     = no self-registration at all (invitations still work).
REGISTRATION_MODE=first-user

# Two-step sign-in with an authenticator app. Strongly recommended; leave on.
REQUIRE_TOTP=true

SESSION_MAX_AGE_HOURS=336
SESSION_IDLE_TIMEOUT_MINUTES=4320

# Leave empty to follow APP_URL (secure cookies whenever APP_URL is https://).
COOKIE_SECURE=

# One-time Helper invitation lifetime.
INVITATION_TTL_HOURS=72

# ---------------------------------------------------------------------------
# Object storage (any S3-compatible service): see docs/object-storage.md
# ---------------------------------------------------------------------------

# Leave empty for AWS S3. Examples:
#   Cloudflare R2:  https://<account-id>.r2.cloudflarestorage.com   (S3_REGION=auto)
#   Backblaze B2:   https://s3.<region>.backblazeb2.com
#   Hetzner:        https://<location>.your-objectstorage.com
#   MinIO / SeaweedFS (self-hosted): http://s3:8333 with S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=
S3_REGION=us-east-1
# REQUIRED.
S3_BUCKET=openrampart
# REQUIRED.
S3_ACCESS_KEY_ID=
# REQUIRED.
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Create the bucket at startup if it is missing (handy for self-hosted stores).
S3_CREATE_BUCKET=false
# Optional prefix if the bucket is shared, e.g. "openrampart/".
S3_KEY_PREFIX=

# docker-compose.yml only: run the bundled SeaweedFS S3 service as well.
# Then set S3_ENDPOINT=http://s3:8333, S3_FORCE_PATH_STYLE=true, S3_CREATE_BUCKET=true.
# COMPOSE_PROFILES=bundled-s3

MAX_UPLOAD_MB=50

# ---------------------------------------------------------------------------
# Deletion
# ---------------------------------------------------------------------------

# Deleted items stay recoverable from the Trash for this many days, then are purged.
DELETION_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# OCR (Tesseract + OCRmyPDF, installed in the container image)
# ---------------------------------------------------------------------------

OCR_ENABLED=true
# Tesseract language codes joined with "+", e.g. eng+cym. Each language needs its
# data installed: build the image with --build-arg OCR_LANGUAGE_PACKS="eng cym".
OCR_LANGUAGES=eng
OCR_TIMEOUT_SECONDS=300
OCR_CONCURRENCY=1
OCR_MAX_PDF_PAGES=200

# ---------------------------------------------------------------------------
# Independent timestamps (OpenTimestamps): see docs/timestamping.md
# ---------------------------------------------------------------------------

# none | opentimestamps. With opentimestamps, only SHA-256 hashes (batched into a
# Merkle tree with random nonces) leave the server, never your content.
TIMESTAMP_PROVIDER=none
# Comma-separated calendar servers. Leave empty for the defaults.
OTS_CALENDARS=
OTS_MIN_CALENDARS=1
OTS_BATCH_INTERVAL_MINUTES=10
OTS_UPGRADE_INTERVAL_MINUTES=180
# Esplora-compatible API used to check Bitcoin block headers during verification.
BITCOIN_EXPLORER_URL=https://blockstream.info/api

# ---------------------------------------------------------------------------
# OAuth 2.1 and MCP: see docs/oauth.md and docs/mcp.md
# ---------------------------------------------------------------------------

# Leave empty: the issuer is APP_URL and the MCP resource is APP_URL/mcp.
OAUTH_ISSUER=
MCP_RESOURCE_URL=
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_DAYS=30
# Dynamic Client Registration (RFC 7591) and Client ID Metadata Documents.
OAUTH_ENABLE_DCR=true
OAUTH_ENABLE_CIMD=true

# ---------------------------------------------------------------------------
# Email: see docs/email.md
# ---------------------------------------------------------------------------

# none | elasticemail | smtp   (log = print to the console; development only)
MAIL_PROVIDER=none
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=OpenRampart

# Elastic Email HTTP API (v4). Create a key with "Send Http" permission only.
ELASTIC_EMAIL_API_KEY=
ELASTIC_EMAIL_API_URL=https://api.elasticemail.com/v4

# Any SMTP server. SMTP_SECURE=true for implicit TLS (port 465); STARTTLS is used otherwise.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# Local development (npm run dev with docker-compose.dev.yml) — replace the values above:
# ---------------------------------------------------------------------------
# NODE_ENV=development
# APP_URL=http://localhost:3000
# DATABASE_URL=postgres://openrampart:openrampart@localhost:5432/openrampart
# S3_ENDPOINT=http://localhost:8333
# S3_ACCESS_KEY_ID=openrampart
# S3_SECRET_ACCESS_KEY=openrampart-dev-secret
# S3_FORCE_PATH_STYLE=true
# S3_CREATE_BUCKET=true
# MAIL_PROVIDER=log
# REGISTRATION_MODE=open
